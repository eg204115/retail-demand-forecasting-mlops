# Copy to .env and fill in. .env is gitignored.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Feast online store ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Serving ---
# Base name only: the two quantile heads are registered as <name>-q50 and <name>-q90.
MODEL_NAME=shelfcast-demand-forecaster
MODEL_STAGE=Production
SERVING_PORT=8000
LOG_LEVEL=INFO

# --- Cloud (deploy workflow) ---
AWS_REGION=ap-south-1
ECR_REPOSITORY=shelfcast-serving
ECS_CLUSTER=shelfcast
ECS_SERVICE=shelfcast-serving
